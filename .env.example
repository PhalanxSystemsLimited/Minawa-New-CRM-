# Copy to .env.local (on your computer) or set these in Vercel › Project › Settings › Environment Variables.
# With none of the Supabase values set, the CRM runs in local mode: data in data/local-db.json, sample data.

# ---------- The CRM ----------
# Public address, used for the Pay Now button in WhatsApp messages (https://crm.minawagroup.pk/pay/PL-4801).
APP_URL=http://localhost:3000
# Any long random string. Supabase pg_cron sends it to /api/cron/daily and /api/cron/dispatch.
CRON_SECRET=change-me-to-a-long-random-string
# Pin "today" (YYYY-MM-DD) for testing. Leave empty in production. The sample data is as of 2026-11-11.
APP_TODAY=2026-11-11

# ---------- Supabase (Project Settings › API) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- WhatsApp (sent by hand from Send on WhatsApp; no WhatsApp Business API) ----------
# While testing: every chat opens with this number instead of the owner's. Remove it to go live.
WHATSAPP_TEST_NUMBER=

# ---------- Safepay (Developers › API keys; Developers › Endpoints for the webhook secret) ----------
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
# sandbox (test payments) or production (real payments)
SAFEPAY_ENV=sandbox
# true only on your computer or a staging site: the Pay Now page offers a test checkout when Safepay isn't set up.
ALLOW_SIMULATED_PAYMENTS=true

# ---------- Local mode only ----------
# Password for admin@minawa.local and accountant@minawa.local
LOCAL_PASSWORD=minawa
