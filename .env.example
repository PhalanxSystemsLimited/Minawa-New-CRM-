# Copy to .env.local (on your computer) or set these in Vercel › Project › Settings › Environment Variables.
# With none of the Supabase values set, the CRM runs in local mode: data in data/local-db.json, sample data.

# ---------- The CRM ----------
# The CRM's public address (https://crm.minawagroup.pk).
APP_URL=http://localhost:3000
# Any long random string. Vercel Cron sends it to /api/cron/daily.
CRON_SECRET=change-me-to-a-long-random-string
# Pin "today" (YYYY-MM-DD) for testing. Leave empty in production. The sample data is as of 2026-11-11.
APP_TODAY=2026-11-11

# ---------- Supabase (Project Settings › API) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Photos (Cloudinary) ----------
# Payment photos and Oakwood electricity bill photos are stored privately in Cloudinary (Settings > API Keys in the
# Cloudinary console). Server only: the secret never reaches the browser. Without these, live shows "Photos aren't set
# up yet"; a laptop copy without Supabase keeps photos in data/images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: the Cloudinary folder (default minawa-crm)
CLOUDINARY_FOLDER=

# ---------- WhatsApp (sent by hand from Send on WhatsApp; no WhatsApp Business API) ----------
# While testing: every chat opens with this number instead of the owner's. Remove it to go live.
WHATSAPP_TEST_NUMBER=

# ---------- Local mode only ----------
# Password for admin@minawa.local and accountant@minawa.local
LOCAL_PASSWORD=minawa
